{
  "name": "whoop-mcp",
  "version": "0.1.0",
  "description": "MCP server for reading your WHOOP data through the official WHOOP Developer API (v2).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "whoop-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "mcp",
    "whoop",
    "model-context-protocol",
    "oauth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rembaumann/whoop-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
