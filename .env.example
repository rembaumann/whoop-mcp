# Copy to .env and fill in. .env is gitignored. Never commit real secrets.
#
# Create an app at https://developer.whoop.com and register the redirect URI
# exactly (Whoop dashboard → your app → Redirect URL).

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://127.0.0.1:8787/callback

# IANA timezone used for "today" / "yesterday" when a tool omits the date.
WHOOP_TIMEZONE=America/New_York

# Optional. Defaults to ~/.whoop-mcp (tokens.json + intents.json, mode 0600).
# WHOOP_DATA_DIR=

# Optional. Official API origin. Do not point this at unofficial Whoop hosts.
# WHOOP_API_BASE=https://api.prod.whoop.com/developer
